{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug current vitest file",
            "autoAttachChildProcesses": true,
            "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
            "program": "${workspaceRoot}/node_modules/vitest/vitest.mjs",
            "args": ["run", "--testTimeout=0", "--no-file-parallelism", "${relativeFile}"],
            "smartStep": true,
            "console": "integratedTerminal"
        },
        {
            "type": "debugpy",
            "request": "launch",
            "name": "Debug current pytest file",
            "module": "pytest",
            "args": ["${relativeFile}", "-x", "-p", "no:cacheprovider"],
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
