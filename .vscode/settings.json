{
    // Tools come from the nix dev shell; the direnv extension puts them on PATH.
    "direnv.restart.automatic": true,
    "editor.defaultFormatter": "EditorConfig.EditorConfig",
    "editor.formatOnSave": true,

    // Nix
    "nix.enableLanguageServer": true,
    "nix.serverPath": "nixd",
    "nix.formatterPath": "nixfmt",
    "[nix]": {
        "editor.defaultFormatter": "jnoortheen.nix-ide"
    },

    // Python: ruff formats and lints, ty is the language server (Pylance off).
    "python.languageServer": "None",
    "python.terminal.activateEnvironment": false,
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": ["packages"],
    "ruff.nativeServer": "on",
    "ruff.importStrategy": "fromEnvironment",
    "ty.importStrategy": "fromEnvironment",
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },

    // TypeScript: the workspace's tsgo, oxlint and oxfmt.
    "oxc.useExecPath": true,
    "oxc.path.oxfmt": "node_modules/oxfmt/bin/oxfmt",
    "oxc.path.oxlint": "node_modules/oxlint/bin/oxlint",
    "js/ts.experimental.useTsgo": true,
    "js/ts.tsdk.path": "./node_modules/typescript/bin",
    "js/ts.tsdk.promptToUseWorkspaceVersion": true,
    "js/ts.tsdk.additionalLocations": ["./node_modules/typescript/bin"],
    "js/ts.preferences.autoImportFileExcludePatterns": [".direnv/**"],
    "[typescript][typescriptreact][javascript][javascriptreact][json][jsonc]": {
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "vitest.runtime": "node",

    "files.watcherExclude": {
        ".direnv/**": true,
        "**/node_modules/**": true,
        "**/dist/**": true
    },
    "search.exclude": {
        ".direnv/**": true,
        "**/node_modules/**": true,
        "**/dist/**": true,
        "pnpm-lock.yaml": true,
        "uv.lock": true,
        "flake.lock": true
    }
}
