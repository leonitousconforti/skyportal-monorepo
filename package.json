        "build": "pnpm -r build",
        "test": "vitest"
    },
    "devDependencies": {
        "@babel/cli": "8.0.4",
        "@babel/core": "8.0.1",
        "@babel/plugin-transform-export-namespace-from": "8.0.1",
        "@babel/plugin-transform-modules-commonjs": "8.0.1",
        "@effect/build-utils": "0.8.9",
        "@effect/tsgo": "0.36.5",
        "@types/node": "25.9.5",
        "babel-plugin-annotate-pure-calls": "0.5.0",
        "oxfmt": "0.64.0",
        "oxlint": "1.79.0",
        "oxlint-tsgolint": "7.0.2001",
        "rimraf": "6.1.3",
        "skyportal-js-models": "workspace:^",
        "tsx": "4.23.12",
        "typescript": "7.0.2",
        "valibot": "1.1.0",
