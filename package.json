{
    "name": "skyportal-monorepo",
    "private": true,
    "license": "BSD-3-Clause",
    "type": "module",
    "scripts": {
        "clean": "pnpm -r clean && rimraf *.tsbuildinfo coverage",
        "codegen": "pnpm -r codegen",
        "check": "tsc -b tsconfig.json",
        "lint": "oxlint && oxfmt --check",
        "lint-fix": "oxlint --fix && oxfmt --write",
        "build": "pnpm -r build",
        "test": "vitest",
        "coverage": "vitest --coverage",
        "schema-parity": "tsx tools/schema-parity/dump-ts.ts"
    },
    "devDependencies": {
        "@babel/cli": "8.0.4",
        "@babel/core": "8.0.1",
        "@babel/plugin-transform-export-namespace-from": "8.0.1",
        "@babel/plugin-transform-modules-commonjs": "8.0.1",
        "@effect/build-utils": "0.8.9",
        "@effect/tsgo": "0.36.1",
        "@types/node": "25.9.5",
        "@valibot/to-json-schema": "1.3.0",
        "@vitest/coverage-v8": "4.1.11",
        "babel-plugin-annotate-pure-calls": "0.5.0",
        "oxfmt": "0.62.0",
        "oxlint": "1.77.0",
        "oxlint-tsgolint": "7.0.2001",
        "rimraf": "6.1.3",
        "skyportal-js-models": "workspace:^",
        "tsx": "4.23.11",
        "typescript": "7.0.2",
        "valibot": "1.1.0",
        "vitest": "4.1.11"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
